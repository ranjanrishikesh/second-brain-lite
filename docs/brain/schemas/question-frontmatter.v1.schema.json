{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question-frontmatter.v1.schema.json",
  "title": "Second Brain Lite question frontmatter v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description", "answer_status", "corpus_revision", "last_researched"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "title": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "description": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "answer_status": { "enum": ["answered", "partial", "unanswered", "conflicted"] },
    "corpus_revision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "last_researched": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
